{
  "name": "db-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/db-service/src",
  "projectType": "library",
  "tags": ["type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/db-service",
        "main": "libs/db-service/src/index.ts",
        "tsConfig": "libs/db-service/tsconfig.lib.json",
        "assets": ["libs/db-service/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/db-service/jest.config.ts"
      }
    }
  }
}
