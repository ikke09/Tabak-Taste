{
  "name": "tabak-taste",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "migrate": "nx migrate latest",
    "start": "nx run-many -t serve --projects=tag:type:app",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "test": "nx run-many -t test",
    "db:init": "npm run db:types && npm run db:migrate && npm run db:seed",
    "db:types": "nx run db-schema:db:types",
    "db:migrate": "dotenv -e libs/db-schema/.env -c -- nx run db-schema:db:migrate",
    "db:update": "dotenv -e libs/db-schema/.env -c -- nx run db-schema:db:update",
    "db:seed": "dotenv -e libs/db-schema/.env -c -- nx run db-schema:db:seed",
    "docker:dev:up": "dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.dev.yml up --build -d --wait && npm run db:init",
    "docker:dev:down": "dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.dev.yml down",
    "docker:prod:up": "npm run build && dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.prod.yml up --build --wait",
    "docker:prod:down": "dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.prod.yml down"
  },
  "private": true,
  "devDependencies": {
    "@emotion/babel-plugin": "11.12.0",
    "@nx-tools/nx-container": "^6.0.2",
    "@nx-tools/nx-prisma": "^6.1.0",
    "@nx/esbuild": "19.7.2",
    "@nx/eslint": "19.7.2",
    "@nx/express": "19.7.2",
    "@nx/jest": "19.7.2",
    "@nx/js": "19.7.2",
    "@nx/node": "19.7.2",
    "@nx/react": "19.7.2",
    "@nx/vite": "19.7.2",
    "@testing-library/react": "16.0.1",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "22.5.4",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/parser": "8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv-cli": "^7.4.2",
    "jsdom": "~25.0.0",
    "nx": "19.7.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "5.6.2"
  },
  "workspaces": [
    "packages/*",
    "libs/*",
    "apps/*"
  ],
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.0.2",
    "@mui/material": "^6.0.2",
    "@prisma/client": "^5.19.1",
    "awesome-debounce-promise": "^2.1.0",
    "axios": "1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.20.0",
    "helmet": "^7.1.0",
    "prisma": "^5.19.1",
    "react": "18.3.1",
    "react-async-hook": "^4.0.0",
    "react-dom": "18.3.1",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.7.0",
    "use-constant": "^1.1.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": "^20"
  }
}
