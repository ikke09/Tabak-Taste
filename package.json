{
  "name": "tabak-taste",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "migrate": "nx migrate latest",
    "start": "nx run-many -t serve --projects=tag:type:app",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "test": "nx run-many -t test",
    "db:init": "npm run db:types && npm run db:migrate && npm run db:seed",
    "db:types": "nx run db-schema:db:types",
    "db:migrate": "dotenv -e libs/db-schema/.env -c -- nx run db-schema:db:migrate",
    "db:update": "dotenv -e libs/db-schema/.env -c -- nx run db-schema:db:update",
    "db:seed": "dotenv -e libs/db-schema/.env -c -- nx run db-schema:db:seed",
    "docker:dev:up": "dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.dev.yml up --build -d --wait",
    "docker:dev:down": "dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.dev.yml down",
    "docker:prod:up": "npm run build && dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.prod.yml up --build --wait",
    "docker:prod:down": "dotenv -e libs/db-schema/.env -c -- docker compose -f docker-compose.prod.yml down"
  },
  "private": true,
  "devDependencies": {
    "@emotion/babel-plugin": "11.11.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "~9.5.0",
    "@nx-tools/nx-container": "^6.0.1",
    "@nx-tools/nx-prisma": "^6.0.1",
    "@nx/esbuild": "^19.3.0",
    "@nx/eslint": "19.3.0",
    "@nx/eslint-plugin": "19.3.0",
    "@nx/express": "19.3.0",
    "@nx/jest": "19.3.0",
    "@nx/js": "19.3.0",
    "@nx/node": "19.3.0",
    "@nx/react": "19.3.0",
    "@nx/vite": "19.3.0",
    "@swc-node/register": "1.9.2",
    "@swc/cli": "0.3.12",
    "@swc/core": "1.6.3",
    "@testing-library/react": "16.0.0",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/parser": "7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "1.6.0",
    "@vitest/ui": "1.6.0",
    "dotenv-cli": "^7.4.2",
    "esbuild": "^0.19.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-xo-typescript": "^4.0.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsdom": "~24.1.0",
    "nx": "19.3.0",
    "prettier": "^3.3.2",
    "react-refresh": "^0.14.2",
    "ts-jest": "^29.1.5",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "url-loader": "^4.1.1",
    "vite": "^5.3.1",
    "vitest": "1.6.0"
  },
  "workspaces": [
    "packages/*",
    "libs/*",
    "apps/*"
  ],
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@prisma/client": "^5.15.1",
    "@swc/helpers": "0.5.11",
    "awesome-debounce-promise": "^2.1.0",
    "axios": "1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "prisma": "^5.15.1",
    "react": "18.3.1",
    "react-async-hook": "^4.0.0",
    "react-dom": "18.3.1",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.6.3",
    "use-constant": "^1.1.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": "^20"
  }
}
