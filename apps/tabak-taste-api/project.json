{
  "name": "tabak-taste-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/tabak-taste-api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/tabak-taste-api",
        "main": "apps/tabak-taste-api/src/main.ts",
        "tsConfig": "apps/tabak-taste-api/tsconfig.app.json",
        "assets": [],
        "generatePackageJson": true,
        "format": [
          "esm"
        ],
        "platform": "node",
        "bundle": true
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "tabak-taste-api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "tabak-taste-api:build:development"
        },
        "production": {
          "buildTarget": "tabak-taste-api:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/tabak-taste-api/jest.config.ts"
      }
    }
  },
  "tags": [
    "type:app"
  ]
}